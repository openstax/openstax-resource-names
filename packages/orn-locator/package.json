{
  "name": "@openstax/orn-locator",
  "version": "1.5.2",
  "dependencies": {
    "@openstax/open-search-client": "^0.1.1",
    "@openstax/ts-utils": "1.51.0",
    "domutils": "^3.0.1",
    "htmlparser2": "^8.0.1",
    "path-to-regexp": "^6.2.0",
    "tiny-async-pool": "^1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.2.0",
    "@types/tiny-async-pool": "1",
    "cspell": "^10.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-import-x": "^4.15.0",
    "eslint-plugin-jest": "^29.16.0",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "npm-run-all2": "^9.0.2",
    "ts-jest": "^29.4.1",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.48.0",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.0",
    "yargs": "^17.5.1"
  },
  "exports": {
    ".": {
      "browser": "./dist/esm/index.js",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./*": {
      "browser": "./dist/esm/*.js",
      "import": "./dist/esm/*.js",
      "require": "./dist/cjs/*.js"
    },
    "./resolve": {
      "browser": "./dist/esm/resolve.browser.js",
      "import": "./dist/esm/resolve.nodejs.js",
      "require": "./dist/cjs/resolve.nodejs.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/openstax/openstax-resource-names.git",
    "directory": "packages/orn-locator"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "index.js",
  "sideEffects": false,
  "scripts": {
    "build": "./script/build.bash",
    "build:clean": "npm run clean && npm run build",
    "build:example": "npm run build && webpack -c ./example/webpack.config.js",
    "ci": "CI=true npm-run-all ci:*",
    "ci:build": "npm run build -- --clean",
    "ci:lint": "eslint --max-warnings=0 .",
    "ci:spelling": "git ls-files | cspell -c ../../cspell.json --file-list stdin",
    "ci:test": "jest --coverage",
    "ci:typecheck": "tsc --noEmit",
    "clean": "rm -rf dist build",
    "coverage-report": "open coverage/index.html",
    "start": "./script/build.bash --watch",
    "test": "jest"
  },
  "types": "index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "dist/esm/*",
        "dist/esm/*.d.ts",
        "dist/esm/*/index.d.ts"
      ]
    }
  }
}
