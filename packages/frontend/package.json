    "react-dom": "^19.2.7",
    "styled-components": "^5.3.5",
    "typescript": "5.9.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@project/lambdas": "1.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.5",
    "cspell": "^10.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
